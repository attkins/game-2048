{
  "name": "game-2048",
  "version": "0.0.0",
  "private": true,
  "description": "A 2048-style merge puzzle with 3D poker chips, played in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "git-cliff --output CHANGELOG.md",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "git-cliff": "^2.0.0",
    "typescript": "~5.9",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
